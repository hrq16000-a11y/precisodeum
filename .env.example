# =============================================================================
# Preciso de Um — variáveis de ambiente (exemplo versionado)
# Copie para `.env` e preencha. NUNCA commite o `.env` real.
# Este arquivo documenta TUDO que é necessário para rodar o projeto em uma
# hospedagem externa, sem dependência do ambiente original.
# =============================================================================

# ── Frontend (Vite — expostas no bundle, são chaves públicas) ───────────────
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi...anon-key..."
VITE_SUPABASE_PROJECT_ID="seu-projeto-ref"

# ── Backend / Edge Functions (SECRETO — nunca no bundle do browser) ────────
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi...anon-key..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...service-role-key..."

# Proteção dos endpoints agendados (cron/pg_cron chama com este header).
CRON_SECRET="gere-com-openssl-rand-hex-32"

# ── Web Push (notificações) ────────────────────────────────────────────────
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@seudominio.com.br"

# ── E-mail transacional (opcional — só se usar Resend) ─────────────────────
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET="whsec_..."

# ── Storage endpoints ──────────────────────────────────────────────────────
# Buckets esperados (mesmos nomes e visibilidade da origem):
#   avatars (público), portfolio (público), service-images (público),
#   sponsors (público), sponsor_assets (PRIVADO)
STORAGE_PUBLIC_BASE_URL="https://SEU-PROJETO.supabase.co/storage/v1/object/public"

# ── Pipeline de portabilidade (export / restore / validate) ────────────────
# Origem (leitura) — usado por `npm run portability:export-media`
SOURCE_SUPABASE_URL="https://ORIGEM.supabase.co"
SOURCE_SUPABASE_SERVICE_ROLE_KEY=""

# Destino (escrita) — usado por restore/validate
TARGET_SUPABASE_URL="https://DESTINO.supabase.co"
TARGET_SUPABASE_SERVICE_ROLE_KEY=""

# Dry-run do restore (não grava nada, apenas simula e gera logs)
PORTABILITY_DRY_RUN="false"

# ── Domínio público (canonical, sitemap, OG) ───────────────────────────────
PUBLIC_SITE_URL="https://www.precisodeum.com.br"
